# AI Evidence Verification (Phase 7)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_TIMEOUT_SECONDS=30
AI_CONFIDENCE_THRESHOLD=0.70
