# Database Configuration
DB_USER=carbontrack_user
DB_PASSWORD=carbontrack_pass
DB_NAME=carbontrack_db
DB_HOST=localhost
DB_PORT=5432

# JWT Security
# Generate a strong 256-bit key for production. This is an example.
JWT_SECRET=this-is-a-very-secure-secret-key-for-carbontrack-development
